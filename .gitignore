# ── Dependencies ─────────────────────────────────────────────────────
node_modules/
.pnpm-store/

# ── Environment / Secrets ─────────────────────────────────────────────
# Ignore all .env files; keep example files safe to commit
.env
.env.*
!.env.example
!.env.*.example

# ── Build outputs ────────────────────────────────────────────────────
dist/
build/
out/

# ── Next.js ──────────────────────────────────────────────────────────
.next/
next-env.d.ts

# ── TypeScript ───────────────────────────────────────────────────────
*.tsbuildinfo

# ── Test & coverage ──────────────────────────────────────────────────
coverage/
.nyc_output/
scratch/

# ── Logs ─────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Claude AI (session data, memory, conversation history) ───────────
.claude/

# ── Design reference ─────────────────────────────────────────────────
Spend_Management.html

# ── OS artefacts ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Editor ───────────────────────────────────────────────────────────
# Share recommended extensions & settings, ignore personal/local overrides
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.swp
*.swo

# ── Prisma generated client (regenerated via prisma generate) ─────────
apps/api/src/generated/

# ── Docker local volumes ──────────────────────────────────────────────
postgres-data/
redis-data/

# ── Railway CLI (local project link + auth state) ──────────────────────
.railway/

# ── TLS / certs (should never be committed) ─────────────────────────────
*.pem
*.key
*.pfx
*.p12

# ── One-off diagnostic/verification scripts (prefix _tmp-) ─────────────
# Safety net for scratch scripts that sometimes touch real credentials
# during debugging (e.g. reading a stored service account key from the DB) -
# meant to be deleted right after use, this just guards against forgetting to.
**/scripts/_tmp-*

# ── Generated report exports (Download Spend Report / Billing History) ──
# Output of local testing, not source - churns on every download.
*.xlsx
